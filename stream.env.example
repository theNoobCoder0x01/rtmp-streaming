# Copy to stream.env and fill in. stream.env is git-ignored; never commit it.

# OBS stream password. Letters, digits, - and _ only.
# Generate one with:  openssl rand -hex 24
STREAM_KEY=

# Browser login for the player pages, dashboard and API
VIEWER_USER=viewer
VIEWER_PASSWORD=

# Instead of VIEWER_PASSWORD you can store only a hash (create with: openssl passwd -6)
# VIEWER_PASSWORD_HASH=
